#usda 1.0
(
    defaultPrim = "X1_URDF_V2"
    metersPerUnit = 1
    upAxis = "Z"
)

# V2 targeted self-collision overlay. Full 31-body articulation
# self-collision creates unnecessary broad-phase work for 4096 training
# environments, while the deployment hazard is the paddle entering the
# chassis. Explicit fine-grained pair filters are safe under Isaac's
# environment replication. Every internal rigid-body pair is filtered except
# Link_r_paddle <-> base_link. Ball, table, and world collisions are unchanged.
def Xform "X1_URDF_V2" (
    prepend references = @X1_URDF_V2_paddle.usd@</X1_URDF_V2>
)
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        prepend rel physics:filteredPairs = [
            </X1_URDF_V2/Link_lun_l>,
            </X1_URDF_V2/Link_lun_r>,
            </X1_URDF_V2/Link_sj>,
            </X1_URDF_V2/Link_l0>,
            </X1_URDF_V2/Link_l1>,
